flowchart TB
    subgraph Browser["Chrome / Edge"]
        TAB["🎙️ Meeting tab<br/>Meet · Teams · Zoom web · YouTube"]
        POP["Popup<br/>My language · What I hear · What they hear · notes"]
        PANEL["Side panel<br/>Live · Summary · Ask · Meetings"]
        WIDGET["Meet widget<br/>+ voice interceptor (WebRTC)<br/>translation or own-voice mix"]
        SW["Service worker<br/>sessions · state · broadcasts"]
        OFS["Offscreen document<br/>tabCapture + mic → PCM 16k<br/>translated playback"]
        OUT["🎧 Output device"]
    end

    subgraph Backend["FastAPI backend · localhost:8000"]
        WS["/ws/translate<br/>LiveSession"]
        REST["REST API<br/>meetings · summarize · chat · providers"]
        REG{{"Provider registry<br/>key-based defaults"}}
        STORE[("SQLite<br/>meetings · segments · chat · FTS5")]
        SUMM["Summarizer<br/>JSON schema · map-reduce"]
        CHAT["Chat (SSE)<br/>meeting context · cross-meeting search"]
        DASH["Dashboard /<br/>keys & settings"]
    end

    subgraph STT["Speech-to-text"]
        SONIOX["Soniox<br/>diarization + translation + language ID"]
        DG["Deepgram<br/>diarization + language ID"]
        SMX["Speechmatics"]
        AZS["Azure Speech"]
    end

    subgraph TTS["Text-to-speech"]
        TTSP["Soniox · Azure · Deepgram<br/>MiniMax · Speechmatics"]
    end

    subgraph LLM["LLM"]
        GEM["Gemini"]
        GROQ["Groq"]
    end

    MEM[("Supermemory<br/>one doc per meeting")]

    TAB -->|"tab audio"| OFS
    OFS -->|"PCM chunks"| SW
    WIDGET -->|"your mic PCM (Meet)"| SW
    POP --> SW
    PANEL --> SW
    SW <-->|"WebSocket<br/>config · PCM · transcript · WAV"| WS
    SW -->|"translated WAV"| OFS
    OFS --> OUT
    SW -.->|"broadcast state / transcript"| PANEL
    SW -.-> WIDGET
    PANEL <-->|"HTTP"| REST

    WS --> REG
    REG --> STT
    REG --> TTS
    REG --> LLM
    WS --> STORE
    REST --> STORE
    REST --> SUMM
    REST --> CHAT
    SUMM --> LLM
    CHAT --> LLM
    CHAT --> MEM
    STORE -->|"checkpoint + on end"| MEM
