{
  "manifest_version": 3,
  "name": "Distill — Live Translation & Meeting Notes",
  "description": "Live translation, transcription, AI summaries and chat for Google Meet, Teams, Zoom web and any tab.",
  "version": "1.0.0",
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Distill",
    "default_icon": {
      "16": "public/icon16.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/meet-interceptor.ts-Cn356xCS.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/meet-bridge.ts-Dmi6coxn.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/meet-widget.ts-loader-C7lTugJT.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "resources": [
        "assets/meet-interceptor.ts-Cn356xCS.js",
        "assets/meet-bridge.ts-Dmi6coxn.js",
        "assets/languages-l3NF9G8N.js",
        "assets/protocol-YEH95tgC.js",
        "assets/meet-widget.ts-CkN-6W78.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
