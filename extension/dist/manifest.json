{
  "manifest_version": 3,
  "name": "Interpreter — Live Translation",
  "description": "Real-time speaker translation for web chat apps. Hear everything in your native tongue.",
  "version": "1.0.0",
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Interpreter",
    "default_icon": {
      "16": "public/icon16.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/meet-interceptor.ts-D8q6riz8.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/meet-bridge.ts-cTUY6hFW.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/meet-widget.ts-loader-BFM6_fvg.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "resources": [
        "assets/meet-interceptor.ts-D8q6riz8.js",
        "assets/meet-bridge.ts-cTUY6hFW.js",
        "assets/languages-l3NF9G8N.js",
        "assets/meet-widget.ts-CUfG7FD6.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
