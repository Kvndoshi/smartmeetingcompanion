# ── Distill backend environment ──────────────────────────────────────
# Copy to backend/.env (or set keys from the dashboard at http://localhost:8000).
# Only the keys you set are used; everything else is optional. Providers are
# picked automatically from the keys you set (order shown below) unless you
# pin one with the *_PROVIDER variables or from the extension popup.

# ── Speech-to-text (live transcription + diarization) ────────────────
# Default order: soniox → deepgram → speechmatics → azure

# Soniox: realtime STT + speaker diarization + native translation + TTS.
# https://console.soniox.com
SONIOX_API_KEY=

# Deepgram: realtime STT (Nova-3) with diarization; Aura TTS. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Speechmatics: realtime STT + translation. https://portal.speechmatics.com
SPEECHMATICS_API_KEY=

# Azure Speech (STT, translation, neural TTS). Region e.g. eastus.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Azure Translator (text) for diarized Azure STT; falls back to the speech key.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# MiniMax: TTS + text translation. https://www.minimax.io
MINIMAX_API_KEY=

# ── LLM (summaries, chat, text translation) ──────────────────────────
# Default order: gemini → groq
# Gemini: https://aistudio.google.com/apikey  (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# ── Memory (chat across meetings) ────────────────────────────────────
# Supermemory: https://console.supermemory.ai — each meeting becomes one document.
SUPERMEMORY_API_KEY=
# 0 disables the automatic retry of meetings saved before a key was set.
SUPERMEMORY_AUTO_SYNC=1

# ── Provider defaults (blank = automatic from the keys above) ────────
# STT_PROVIDER: soniox | deepgram | speechmatics | azure | azure_diarize
STT_PROVIDER=
# TTS_PROVIDER: soniox | azure | deepgram | minimax | speechmatics
TTS_PROVIDER=
# LLM_PROVIDER: gemini | groq
LLM_PROVIDER=
# Text translation when the STT provider has no native translation (Deepgram):
# TRANSLATION_PROVIDER: llm | azure_translator | minimax
TRANSLATION_PROVIDER=
# Which LLM the "llm" translator prefers (groq is usually fastest).
LLM_TRANSLATION_PROVIDER=groq

# ── Models (blank = built-in default) ────────────────────────────────
GEMINI_MODEL=
GEMINI_FAST_MODEL=
GROQ_MODEL=
GROQ_FAST_MODEL=
# Soniox realtime STT model (default stt-rt-v6) and TTS model/voice.
SONIOX_STT_MODEL=
SONIOX_TTS_MODEL=
SONIOX_TTS_VOICE=
# Per-language voice, e.g. SONIOX_TTS_VOICE_ES=...
# Deepgram STT model (default nova-3). Diarization parameter (default
# "diarize_model=latest"; set "diarize=true" for the legacy diarizer).
DEEPGRAM_STT_MODEL=
DEEPGRAM_DIARIZE=
# Per-language Aura voice, e.g. DEEPGRAM_TTS_MODEL_ES=...
MINIMAX_TEXT_MODEL=
MINIMAX_TTS_MODEL=
MINIMAX_TTS_VOICE_ID=

# ── Meeting notes behaviour ──────────────────────────────────────────
# Summarise automatically when a meeting ends (needs an LLM key).
AUTO_SUMMARY=1
# Language of summaries (ISO code). Can be changed per meeting in the side panel.
SUMMARY_LANGUAGE=en
# How often (s) a live meeting is checkpointed to Supermemory.
MEMORY_CHECKPOINT_SECONDS=300

# ── Latency tuning ───────────────────────────────────────────────────
# Text-translation path: translate once this many characters are buffered…
TRANSLATION_TRIGGER_CHAR_THRESHOLD=60
# …or after this much silence (ms).
TRANSLATION_FLUSH_MS=1200
# Soniox endpoint delay (ms, 500-3000): lower = faster finals.
SONIOX_MAX_ENDPOINT_DELAY_MS=
# Deepgram endpointing / utterance-end (ms).
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1200
# Speechmatics finalisation delay (seconds) and websocket URL.
SPEECHMATICS_MAX_DELAY=1.0
SPEECHMATICS_RT_WS_URL=wss://eu.rt.speechmatics.com/v2/
USE_SPEECHMATICS_TRANSLATION=1
# Azure end-of-segment silence (ms).
AZURE_SEGMENTATION_SILENCE_MS=500
